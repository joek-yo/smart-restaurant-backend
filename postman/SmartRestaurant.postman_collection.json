{
  "info": {
    "name": "SmartRestaurant Full API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API test suite for SmartRestaurant backend with automated assertions"
  },
  "item": [
    {
      "name": "Sessions - Add to Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Response contains session data', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('userId');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "http://localhost:5000/sessions/add-to-cart",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions", "add-to-cart"]
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"businessId\": \"biz001\", \"branchId\": \"branch01\", \"userId\": \"user123\", \"phone\": \"1234567890\", \"productId\": \"prod789\", \"quantity\": 2 }"
        }
      }
    },
    {
      "name": "Sessions - Get by Phone",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Body is an object or array', () => {",
              "    pm.expect(pm.response.json()).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/sessions/1234567890",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions", "1234567890"]
        }
      }
    },
    {
      "name": "Menu - List Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Returns a list of products', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/menu/products/biz001",
          "host": ["localhost"],
          "port": "5000",
          "path": ["menu", "products", "biz001"]
        }
      }
    },
    {
      "name": "Sessions - Checkout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 or 200', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "http://localhost:5000/sessions/checkout",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions", "checkout"]
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"businessId\": \"biz001\", \"branchId\": \"branch01\", \"userId\": \"user123\", \"phone\": \"1234567890\", \"paymentMethod\": \"card\" }"
        }
      }
    }
  ]
}