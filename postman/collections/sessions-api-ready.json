{
  "info": {
    "name": "Sessions CLI Tests (Stateful)",
    "_postman_id": "sessions-cli-tests-002",
    "description": "Stateful CLI testing for Sessions module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000"
    },
    {
      "key": "USER_ID",
      "value": "user001"
    }
  ],

  "item": [

    {
      "name": "1️⃣ Add To Cart (Creates Session)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/sessions/cart",
          "host": ["{{BASE_URL}}"],
          "path": ["sessions", "cart"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user001\",\n  \"productId\": \"prod001\",\n  \"quantity\": 2,\n  \"price\": 250\n}"
        }
      }
    },

    {
      "name": "2️⃣ Get Session (Verify Cart)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/sessions?userId={{USER_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["sessions"],
          "query": [
            {
              "key": "userId",
              "value": "{{USER_ID}}"
            }
          ]
        }
      }
    },

    {
      "name": "3️⃣ Update Quantity (Now Exists)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/sessions/cart/quantity",
          "host": ["{{BASE_URL}}"],
          "path": ["sessions", "cart", "quantity"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user001\",\n  \"productId\": \"prod001\",\n  \"quantity\": 3\n}"
        }
      }
    },

    {
      "name": "4️⃣ Checkout Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/sessions/checkout",
          "host": ["{{BASE_URL}}"],
          "path": ["sessions", "checkout"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user001\"\n}"
        }
      }
    }

  ]
}