{
  "info": {
    "name": "SmartRestaurant Full API (FIXED)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Aligned with current NestJS backend routes"
  },
  "item": [
    {
      "name": "Sessions - Add to Cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:5000/sessions/cart",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions", "cart"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"businessId\": \"{{businessId}}\",\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "Sessions - Get All",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/sessions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "Menu - List Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/menu/products/{{businessId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["menu", "products", "{{businessId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "Sessions - Checkout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:5000/sessions/checkout",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["sessions", "checkout"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"businessId\": \"{{businessId}}\",\n  \"userId\": \"{{userId}}\",\n  \"paymentMethod\": \"card\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}